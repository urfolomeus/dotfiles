{
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "~/.config/vscode/copilot/instructions": true,
  },
  "chat.mcp.autostart": "newAndOutdated",
  "chat.mcp.gallery.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "cp": true,
    "cd": true,
    "echo": true,
    "ls": true,
    "pwd": true,
    "cat": true,
    "head": true,
    "tail": true,
    "findstr": true,
    "wc": true,
    "tr": true,
    "cut": true,
    "cmp": true,
    "which": true,
    "basename": true,
    "dirname": true,
    "realpath": true,
    "readlink": true,
    "stat": true,
    "file": true,
    "du": true,
    "df": true,
    "sleep": true,
    "grep": true,
    "git status": true,
    "git log": true,
    "git show": true,
    "git diff": true,
    "git grep": true,
    "git branch": true,
    "/^git branch\\b.*-(d|D|m|M|-delete|-force)\\b/": false,
    "Get-ChildItem": true,
    "Get-Content": true,
    "Get-Date": true,
    "Get-Random": true,
    "Get-Location": true,
    "Write-Host": true,
    "Write-Output": true,
    "Split-Path": true,
    "Join-Path": true,
    "Start-Sleep": true,
    "Where-Object": true,
    "/^Select-[a-z0-9]/i": true,
    "/^Measure-[a-z0-9]/i": true,
    "/^Compare-[a-z0-9]/i": true,
    "/^Format-[a-z0-9]/i": true,
    "/^Sort-[a-z0-9]/i": true,
    "column": true,
    "/^column\\b.*-c\\s+[0-9]{4,}/": false,
    "date": true,
    "/^date\\b.*(-s|--set)\\b/": false,
    "find": true,
    "/^find\\b.*-(delete|exec|execdir|fprint|fprintf|fls|ok|okdir)\\b/": false,
    "sort": true,
    "/^sort\\b.*-(o|S)\\b/": false,
    "tree": true,
    "/^tree\\b.*-o\\b/": false,
    "/\\(.+\\)/s": {
      "approve": false,
      "matchCommandLine": true,
    },
    "/\\{.+\\}/s": {
      "approve": false,
      "matchCommandLine": true,
    },
    "/`.+`/s": {
      "approve": false,
      "matchCommandLine": true,
    },
    "rm": false,
    "rmdir": false,
    "del": false,
    "Remove-Item": false,
    "ri": false,
    "rd": false,
    "erase": false,
    "dd": false,
    "kill": false,
    "ps": false,
    "top": false,
    "Stop-Process": false,
    "spps": false,
    "taskkill": false,
    "taskkill.exe": false,
    "curl": false,
    "wget": false,
    "Invoke-RestMethod": false,
    "Invoke-WebRequest": false,
    "irm": false,
    "iwr": false,
    "chmod": false,
    "chown": false,
    "Set-ItemProperty": false,
    "sp": false,
    "Set-Acl": false,
    "jq": true,
    "xargs": false,
    "eval": false,
    "Invoke-Expression": false,
    "iex": false,
    "npm view": true,
    "npm test": true,
    "npm run type-check": true,
    "npm run lint": true,
    "yarn run tsc": true,
    "/^git remote -v$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/bun\\s+(run)\\s+lint/": true,
    "/bun(?:\\s+run)\\s+test/": true,
    "/bun\\s?(run|x)\\s+tsc/": true,
    "/^rtk\\s+acli\\s+jira\\s+workitem\\s+view\\b/": true,
    "/^rtk\\s+gh\\s+pr\\s+(view|diff)\\b/": true,
    "/^rtk\\s+gh\\s+pr\\s+(create|edit|merge|close|reopen|ready)\\b/": false,
    "/^rtk\\s+git(?:\\s+--no-pager)?\\s+diff\\b/": true,
    "/^rtk\\s+(cat|grep|rg|wc)\\b/": true,
    "/>>/": {
      "approve": false,
      "matchCommandLine": true,
    },
  },
  "claudeCode.preferredLocation": "panel",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.fontFamily": "'Dank Mono', 'Cascadia Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "emmet.includeLanguages": {
    "phoenix-heex": "html",
    "vue-html": "html",
  },
  "emmet.triggerExpansionOnTab": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "files.associations": {
    "*.heex": "phoenix-heex",
    "*.livemd": "markdown",
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true,
  },
  "git.autofetch": false,
  "git.autoRepositoryDetection": false,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "github.copilot.enable": {
    "*": true,
    "markdown": false,
    "plaintext": false,
    "scminput": false,
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlens.views.branches.branches.layout": "list",
  "gitlens.views.commits.files.layout": "list",
  "notebook.output.wordWrap": true,
  "notebook.lineNumbers": "on",
  "python.analysis.typeCheckingMode": "strict",
  "redhat.telemetry.enabled": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.env.osx": {
    "SHELL": "/opt/homebrew/bin/fish",
    "Q_NEW_SESSION": "1",
  },
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.initialHint": false,
  "todo-tree.general.showActivityBarBadge": true,
  "todo-tree.general.statusBar": "tags",
  "todo-tree.general.showIconsInsteadOfTagsInStatusBar": true,
  "todo-tree.general.tags": [
    "TODO",
    "NOTE",
    "BUG",
    "FIXME",
    "HACK",
    "[ ]",
    "[x]",
    "[X]",
    "[-]",
  ],
  "todo-tree.general.tagGroups": {
    "[xX]": ["[x]", "[X]"],
    "fixen": ["FIXME", "HACK"],
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "type": "tag",
      "background": "#008000",
      "foreground": "#D7F5E3",
      "icon": "check",
      "iconColour": "#008000",
    },
    "NOTE": {
      "type": "tag",
      "background": "#2F6F96",
      "foreground": "#D9EFFC",
      "icon": "info",
      "iconColour": "#2F6F96",
    },
    "BUG": {
      "type": "tag",
      "background": "#6D1F2B",
      "foreground": "#F9DADF",
      "icon": "bug",
      "iconColour": "#FF0000",
    },
    "fixen": {
      "type": "tag",
      "background": "#7A3F14",
      "foreground": "#FFE9D9",
      "icon": "alert",
      "iconColour": "#FFA500",
    },
    "HACK": {
      "type": "tag",
      "background": "#FFE9D9",
      "foreground": "#7A3F14",
      "icon": "alert",
      "iconColour": "#FFA500",
    },
    "[ ]": {
      "type": "none",
      "hideFromTree": true,
      "hideFromActivityBar": true,
      "hideFromStatusBar": true,
    },
    "[xX]": {
      "type": "text",
      "background": "#D7F5E3",
      "opacity": 0,
      "foreground": "#008000",
      "hideFromTree": true,
      "hideFromActivityBar": true,
      "hideFromStatusBar": true,
    },
    "[-]": {
      "type": "text",
      "background": "#888",
      "opacity": 0,
      "foreground": "#888",
      "hideFromTree": true,
      "hideFromActivityBar": true,
      "hideFromStatusBar": true,
    },
  },
  "todo-tree.highlights.useColourScheme": true,
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  "typescript.experimental.useTsgo": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vscode-office.editorTheme": "Nord",
  "vscode-office.openOutline": false,
  "window.autoDetectColorScheme": true,
  "window.titleBarStyle": "custom",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.ipynb": "jupyter-notebook",
    "*.markdown": "default",
    "*.md": "default",
    "*.pdf": "pdf.preview",
    "file:/**/*.parquet": "jupyter-data-wrangler",
  },
  "workbench.preferredDarkColorTheme": "Catppuccin Frappé",
  "workbench.preferredLightColorTheme": "Catppuccin Frappé",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.iconTheme": null,
  "scm.repositories.selectionMode": "single",
  "chat.byokUtilityModelDefault": "mainAgent",
  "chat.utilityModel": "",
  "chat.utilitySmallModel": "",
  "security.promptForLocalFileProtocolHandling": false,
  "chat.viewSessions.orientation": "stacked",
  "yaml.schemas": {
    "file:///Users/alan/.vscode/extensions/continue.continue-2.0.0-darwin-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml",
    ],
  },
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai/config.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },
}
