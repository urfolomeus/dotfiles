{
  "catppuccin-icons.specificFolders": false,
  "chat.tools.terminal.autoApprove": {
    "cd": true,
    "date": true,
    "/^git (--no-pager\\s+)?(status|log|diff|show|blame|describe|remote(\\s+-v)?|stash list)\\b/": true,
    "/^git (fetch\\b|worktree (add|list)\\b)\\b/": true,
    "/^git (push\\b.*--force|reset\\b.*--hard|clean\\b.*-[a-z]*f|branch\\b.*-D|worktree remove\\b.*-f)\\b/i": false,
    "/^gh (pr (diff|view|list|checks|status)|repo view)\\b/": true,
    "printf": true,
    "realpath": true,
    "set": true,
    "/^yarn ((exec|run)\\s+)?(build|jest|lint|test|tsc)\\b/": true,
    "gh": true,
  },
  "chat.tools.terminal.outputLocation": "terminal",
  "chat.viewSessions.orientation": "stacked",
  "editor.fontFamily": "DankMono Nerd Font",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.rulers": [80, 120],
  "editor.tabSize": 2,
  "extensions.ignoreRecommendations": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "git.blame.editorDecoration.enabled": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "js/ts.experimental.useTsgo": true,
  "scm.repositories.selectionMode": "single",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontFamily": "DankMono Nerd Font",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 14,
  "window.autoDetectColorScheme": false,
  "workbench.colorTheme": "Catppuccin Frappé",
  "workbench.iconTheme": "catppuccin-frappe",
  "workbench.preferredDarkColorTheme": "Catppuccin Frappé",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.startupEditor": "none",
  "gitlens.views.commits.files.layout": "list",
  "gitlens.gitCommands.skipConfirmations": [
    "fetch:command",
    "stash-push:command",
    "launchpad:command",
  ],
  "gitlens.graph.details.location": "auto",
}
